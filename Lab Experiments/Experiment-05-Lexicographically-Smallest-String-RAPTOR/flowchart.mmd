flowchart TD
    A([Start]) --> B[/GET str, ch1, ch2/]
    B --> C["i ← 1, n ← Length_Of(str)"]
    C --> D{i <= n}
    D -- No --> H[/PUT str/]
    H --> I([End])
    D -- Yes --> E{str[i] == ch1}
    E -- Yes --> F["str[i] ← ch2"]
    E -- No --> G{str[i] == ch2}
    G -- Yes --> G1["str[i] ← ch1"]
    F --> J["i ← i + 1"]
    G1 --> J
    G -- No --> J
    J --> D
